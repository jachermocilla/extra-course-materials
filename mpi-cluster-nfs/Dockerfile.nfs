# NFS server node — exports /exports/mpi to the cluster
FROM ubuntu:22.04

LABEL description="NFS Server for MPI Cluster"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    nfs-kernel-server \
    nfs-common \
    rpcbind \
    && rm -rf /var/lib/apt/lists/*

# Create the shared export directory and set open permissions
# (MPI nodes write binaries and data here as mpiuser uid=1000)
#RUN mkdir -p /exports/mpi && \
#    chown 1000:1000 /exports/mpi && \
#    chmod 755 /exports/mpi

# Export the directory to the entire cluster subnet
# rw          — read/write access
# sync        — writes committed before reply (safe)
# no_subtree_check — avoids subtree permission issues in containers
# no_root_squash   — allow root on clients to act as root (needed for setup)
# anonuid/anongid  — map anonymous access to mpiuser (uid/gid 1000)
RUN echo "/exports/mpi *(rw,sync,no_subtree_check,no_root_squash,anonuid=1000,anongid=1000)" \
    > /etc/exports

COPY scripts/nfs-entrypoint.sh /usr/local/bin/nfs-entrypoint.sh
RUN chmod +x /usr/local/bin/nfs-entrypoint.sh

# NFS ports
EXPOSE 111/tcp 111/udp 2049/tcp 2049/udp

ENTRYPOINT ["/usr/local/bin/nfs-entrypoint.sh"]
